# --- Database (use a POOLED connection string on Vercel, e.g. Neon/Supabase pooler) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/livecity?sslmode=require"

# --- App ---
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_NAME="Live in the City"
TRUST_PROXY="true"

# --- Public business details (shown in footer + contact page; empty = hidden) ---
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_ADDRESS=""
NEXT_PUBLIC_CONTACT_HOURS=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_X=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
# Hero background video (mp4/webm URL) and poster image
NEXT_PUBLIC_HERO_VIDEO_URL=""
NEXT_PUBLIC_HERO_POSTER_URL=""

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WA_TEMPLATE_BOOKING_CREATED="booking_created"
WA_TEMPLATE_BOOKING_CONFIRMED="booking_confirmed"
WA_TEMPLATE_OWNER_BOOKING="club_new_booking"
WA_TEMPLATE_TRANSPORT_ASSIGNED="transport_assigned"
WA_TEMPLATE_DRIVER_RIDE="driver_ride_assigned"
WA_TEMPLATE_TRANSPORT_STATUS="transport_status"

# --- Razorpay ---
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
GOOGLE_MAPS_API_KEY=""

# --- Scheduled jobs (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ---
INTERNAL_JOB_SECRET=""
# Set CRON_SECRET to the same value as INTERNAL_JOB_SECRET in Vercel
CRON_SECRET=""

# --- Seed (first deploy only; use a strong unique password) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
