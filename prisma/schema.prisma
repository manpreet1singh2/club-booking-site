generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { CUSTOMER CLUB_OWNER SUPER_ADMIN DRIVER }
enum BookingStatus { PENDING_PAYMENT CONFIRMED CANCELLED COMPLETED EXPIRED REFUND_PENDING REFUNDED }
enum PaymentStatus { PENDING PAID FAILED REFUNDED PARTIAL }
enum TransportType { NONE CAB BIKE }
enum TransportStatus { PENDING ASSIGNED DRIVER_CONFIRMED ON_THE_WAY ARRIVED PICKED_UP COMPLETED CANCELLED }
enum PackagePricing { PER_PERSON FLAT }
enum WebhookEventStatus { RECEIVED PROCESSED FAILED }
model User { id String @id @default(cuid()) name String email String @unique phone String? passwordHash String role Role @default(CUSTOMER) bookings Booking[] driver Driver? sessions Session[] ownedClubs Club[] ticketCheckIns TicketCheckIn[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Club { id String @id @default(cuid()) name String ownerId String? owner User? @relation(fields:[ownerId],references:[id]) slug String @unique city String address String description String? imageUrl String? active Boolean @default(true) events Event[] packages Package[] bookings Booking[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Event { id String @id @default(cuid()) clubId String club Club @relation(fields:[clubId],references:[id]) name String slug String date DateTime startTime String endTime String? capacity Int? active Boolean @default(true) bookings Booking[] createdAt DateTime @default(now())
  @@unique([clubId, slug])
  @@index([clubId, date, active])
}
model Package { id String @id @default(cuid()) clubId String club Club @relation(fields:[clubId],references:[id]) name String description String? price Decimal @db.Decimal(10,2) pricing PackagePricing @default(PER_PERSON) active Boolean @default(true) bookings Booking[] createdAt DateTime @default(now()) }
model Booking { id String @id @default(cuid()) bookingCode String @unique userId String user User @relation(fields:[userId],references:[id]) clubId String club Club @relation(fields:[clubId],references:[id]) eventId String? event Event? @relation(fields:[eventId],references:[id]) packageId String package Package @relation(fields:[packageId],references:[id]) guestCount Int transportType TransportType @default(NONE) visitDate DateTime pickupLocation String? pickupTime DateTime? totalAmount Decimal @db.Decimal(10,2) advanceAmount Decimal @db.Decimal(10,2) remainingAmount Decimal @db.Decimal(10,2) ticketToken String @unique @default(cuid()) status BookingStatus @default(PENDING_PAYMENT) paymentStatus PaymentStatus @default(PENDING) payments Payment[] transport TransportBooking? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TicketCheckIn { id String @id @default(cuid()) bookingId String @unique booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) checkedInAt DateTime @default(now()) checkedInById String checkedInBy User @relation(fields:[checkedInById],references:[id]) }\nmodel Payment { id String @id @default(cuid()) bookingId String booking Booking @relation(fields:[bookingId],references:[id]) gatewayOrderId String? @unique gatewayPaymentId String? @unique gatewaySignature String? webhookEventId String? @unique refundId String? @unique refundedAmount Decimal @db.Decimal(10,2) @default(0) amount Decimal @db.Decimal(10,2) status PaymentStatus @default(PENDING) gateway String? transactionId String? createdAt DateTime @default(now()) }
model PaymentWebhookEvent { id String @id @default(cuid()) provider String eventId String @unique event String status WebhookEventStatus @default(RECEIVED) payload Json? error String? receivedAt DateTime @default(now()) processedAt DateTime?
  @@index([status, receivedAt])
  @@index([event, receivedAt])
}
model Driver { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id]) vehicleType TransportType vehicleNumber String? available Boolean @default(true) assignments TransportBooking[] }
model TransportBooking { id String @id @default(cuid()) bookingId String @unique booking Booking @relation(fields:[bookingId],references:[id]) driverId String? driver Driver? @relation(fields:[driverId],references:[id]) type TransportType status TransportStatus @default(PENDING) pickupLocation String pickupTime DateTime }
model PromoCode { id String @id @default(cuid()) code String @unique type String value Decimal @db.Decimal(10,2) active Boolean @default(true) expiresAt DateTime? }
model NotificationLog { id String @id @default(cuid()) userId String? channel String template String status String providerMessageId String? createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) userId String? action String entity String entityId String? metadata Json? createdAt DateTime @default(now()) }
model Session { id String @id @default(cuid()) tokenHash String @unique userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) expiresAt DateTime createdAt DateTime @default(now())
  @@index([userId, expiresAt])
  @@index([expiresAt])
}